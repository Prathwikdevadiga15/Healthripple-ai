# Copy to .env. Keep real credentials out of source control.

DATABASE_URL=postgresql://healthripple:healthripple@localhost:5432/healthripple
CORS_ORIGINS=http://localhost:5173

# Optional. Groq only phrases answers grounded in HealthRipple risk data.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Only needed if you switch the map from OpenStreetMap tiles to Mapbox.
MAPBOX_TOKEN=
